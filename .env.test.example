# Test-database environment template — CDC Lab Accounts & Asset Management System
#
# Copy this file to `.env.test` (git-ignored) and point it at a real,
# disposable PostgreSQL database whose name ends in "_test". Integration
# and constraint tests (tests/integration/**) refuse to run without this —
# see tests/integration/helpers/test-db.ts and docs/testing.md. This is
# never read as a fallback for DATABASE_URL, and DATABASE_URL is never read
# as a fallback for this — the two are always independent.

TEST_DATABASE_URL="postgresql://cdc_dev:cdc_dev_password@localhost:5432/cdc_lab_accounts_test?schema=public"
