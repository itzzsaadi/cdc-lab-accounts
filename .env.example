# Environment variable template — CDC Lab Accounts & Asset Management System
#
# Copy this file to `.env` (git-ignored) and fill in real local values.
# Never commit real secrets. NFR-MNT-02 requires every variable the app reads
# to be listed here, even if it doesn't yet have real behavior wired to it.
#
# DATABASE_URL is read by both Prisma CLI commands and the application
# runtime locally/in CI (a single, unpooled Postgres). In production
# (Supabase) the two diverge — see DIRECT_URL below — but locally only
# DATABASE_URL is needed. For integration tests, see .env.test.example:
# TEST_DATABASE_URL is deliberately separate and never falls back to this
# development URL.

# PostgreSQL connection string used by Prisma (development database).
DATABASE_URL="postgresql://cdc_dev:cdc_dev_password@localhost:5432/cdc_lab_accounts?schema=public"

# Production only (Supabase). DATABASE_URL becomes Supabase's pooled
# "Transaction pooler" connection string (Supavisor/pgbouncer, port 6543)
# — what the running app uses for every query. DIRECT_URL becomes
# Supabase's "Direct connection" string (port 5432) — used only by Prisma
# CLI commands (`prisma migrate deploy`, `db seed`, `validate`), which need
# a session-mode connection the transaction pooler doesn't support. Leave
# both unset locally/in CI; prisma.config.ts falls back to DATABASE_URL
# when DIRECT_URL is absent.
DIRECT_URL=""

# Production only, optional. Bounds each running instance's Postgres
# connection pool so many concurrent serverless instances can't
# collectively exhaust Supabase's free-tier pooler slots. Leave unset
# locally/in CI (falls back to pg.Pool's own default of 10).
DATABASE_POOL_MAX=""

# Phase 2 — Better Auth / authentication (docs/adr/0003-phase-2-authentication.md)
#
# The public URL this app is served from. src/server/auth.ts refuses to
# start in production unless this is HTTPS — never trust NODE_ENV alone.
BETTER_AUTH_URL="http://localhost:3000"

# Session/token signing secret. Generate a real one for any real deployment
# (e.g. `openssl rand -base64 32`) — Better Auth itself refuses to start in
# production with the library's default secret.
BETTER_AUTH_SECRET="change-me-generate-a-real-32-byte-secret"

# Email transport — "smtp" or "file". Production requires "smtp" (and every
# SMTP_* variable below) or the process refuses to start; "file" is
# development/test-only and additionally refuses to run when
# NODE_ENV=production regardless of this setting (src/lib/email/transport.ts).
EMAIL_TRANSPORT="file"

# SMTP configuration, required only when EMAIL_TRANSPORT=smtp.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Phase 8A - observability. Keep false in production unless actively
# diagnosing; production stack traces are excluded from JSON logs by default.
LOG_STACKS="false"
