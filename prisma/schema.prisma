// CDC Lab Accounts & Asset Management System — Prisma schema
//
// Phase 1 (database & domain foundation) — implements the 13 SRS business
// tables from docs/SRS.md §6, with the deviations recorded in
// docs/adr/0002-phase-1-schema-clarifications.md:
//   - users.password_hash is omitted (Better Auth's `account` table is the
//     future authoritative credential store; that table is deferred to
//     Phase 2, per docs/PROJECT_PLAN.md).
//   - app_settings.updated_by is nullable (the seeded default profit split
//     exists before any user account does).
//   - counter_income has no unique constraint on income_date (FR-CINC-04
//     requires a non-blocking warning, not a hard rejection).
//   - assets uses `status` as its sole archive representation, never
//     `is_archived`.
//   - created_by/updated_by/updated_at are NOT added to parties,
//     expense_items, expense_categories, vendors, or users — only to the
//     genuine financial-entry tables, avoiding a seed/attribution conflict
//     (Phase 1 seeds master data with zero users).
//
// CHECK constraints, partner-eligibility triggers, the audit append-only
// trigger, physical-deletion-rejection triggers, and the instalment
// partial-unique index are not expressible in this schema language and are
// added by hand-editing the generated migration SQL (see
// prisma/migrations/*_init/migration.sql).
//
// Phase 2 (authentication & authorization) adds Better Auth's Session,
// Account, and Verification tables plus five new User columns
// (emailVerified, image, updatedAt, failedLoginCount, lockoutUntil) and two
// AuditAction values (SESSION_REVOKED, ACCOUNT_LOCKED) — see
// docs/adr/0003-phase-2-authentication.md. These three new tables are
// deliberately NOT covered by the physical-deletion-rejection triggers below
// (they are authentication infrastructure, not business/financial/master-
// data/settings/audit records); `users` keeps its existing trigger
// unchanged.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERATOR
  PARTNER
  ADMIN

  @@map("role")
}

enum BillingMode {
  DAILY
  MONTHLY

  @@map("billing_mode")
}

enum ExpenseGroup {
  ADMIN
  PURCHASING

  @@map("expense_group")
}

enum FundingSource {
  BUSINESS
  PARTNER

  @@map("funding_source")
}

enum AssetClassification {
  FIXED
  MOVABLE

  @@map("asset_classification")
}

enum AcquisitionMode {
  INSTALMENT
  CASH

  @@map("acquisition_mode")
}

enum AssetStatus {
  ACTIVE
  ARCHIVED

  @@map("asset_status")
}

enum ReceiptType {
  DAILY
  MONTHLY
  CASH_DIRECT

  @@map("receipt_type")
}

enum ContributionType {
  INITIAL
  INJECTION
  DRAWING

  @@map("contribution_type")
}

/// See docs/adr/0002-phase-1-schema-clarifications.md and the Phase 1 plan
/// for why RESTORE, OFFLINE_UPLOAD, and CONFLICT_RESOLUTION are omitted.
enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  LOGIN
  LOGIN_FAILED
  PASSWORD_CHANGE
  IMPORT
  SESSION_REVOKED
  ACCOUNT_LOCKED

  @@map("audit_action")
}

/// Two partners plus reception staff. No password_hash column — Better
/// Auth's `account` table is the authoritative credential store (see
/// docs/adr/0002-phase-1-schema-clarifications.md decision 2 and
/// docs/adr/0003-phase-2-authentication.md). email_verified, image, and
/// updated_at are Better Auth schema requirements, not SRS fields — see
/// docs/adr/0003-phase-2-authentication.md for why each new column exists
/// and why last_sign_in_at/an invitation-state field were deliberately not
/// added (both derivable from existing data, so adding them would be
/// duplicate state).
model User {
  id               String    @id @default(uuid()) @db.Uuid
  fullName         String    @map("full_name") @db.VarChar(120)
  email            String    @unique @db.VarChar(180)
  role             Role
  isPartner        Boolean   @default(false) @map("is_partner")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  emailVerified    Boolean   @default(false) @map("email_verified")
  image            String?   @db.VarChar(2048)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  failedLoginCount Int       @default(0) @map("failed_login_count") @db.SmallInt
  lockoutUntil     DateTime? @map("lockout_until") @db.Timestamptz(6)

  fundedDailyExpenses         DailyExpense[]        @relation("DailyExpenseFundedBy")
  createdDailyExpenses        DailyExpense[]        @relation("DailyExpenseCreatedBy")
  updatedDailyExpenses        DailyExpense[]        @relation("DailyExpenseUpdatedBy")
  fundedMonthlyExpenses       MonthlyExpense[]      @relation("MonthlyExpenseFundedBy")
  createdMonthlyExpenses      MonthlyExpense[]      @relation("MonthlyExpenseCreatedBy")
  updatedMonthlyExpenses      MonthlyExpense[]      @relation("MonthlyExpenseUpdatedBy")
  createdPartyIncome          PartyIncome[]         @relation("PartyIncomeCreatedBy")
  updatedPartyIncome          PartyIncome[]         @relation("PartyIncomeUpdatedBy")
  createdCounterIncome        CounterIncome[]       @relation("CounterIncomeCreatedBy")
  updatedCounterIncome        CounterIncome[]       @relation("CounterIncomeUpdatedBy")
  capitalContributions        CapitalContribution[] @relation("CapitalContributionPartner")
  createdCapitalContributions CapitalContribution[] @relation("CapitalContributionCreatedBy")
  updatedCapitalContributions CapitalContribution[] @relation("CapitalContributionUpdatedBy")
  purchasedAssets             Asset[]               @relation("AssetPurchasedBy")
  createdAssets               Asset[]               @relation("AssetCreatedBy")
  updatedAssets               Asset[]               @relation("AssetUpdatedBy")
  auditLogEntries             AuditLog[]            @relation("AuditLogActor")
  appSettingUpdates           AppSetting[]          @relation("AppSettingUpdatedBy")
  appSettingsAsPartnerA       AppSetting[]          @relation("AppSettingPartnerA")
  appSettingsAsPartnerB       AppSetting[]          @relation("AppSettingPartnerB")
  sessions                    Session[]
  accounts                    Account[]
  syncOperations              SyncOperation[]       @relation("SyncOperationActor")
  updatedParties              Party[]               @relation("PartyUpdatedBy")
  updatedExpenseItems         ExpenseItem[]         @relation("ExpenseItemUpdatedBy")
  updatedExpenseCategories    ExpenseCategory[]     @relation("ExpenseCategoryUpdatedBy")
  updatedVendors              Vendor[]              @relation("VendorUpdatedBy")
  importBatchesActedOn        ImportBatch[]         @relation("ImportBatchActor")
  importSessionsCreated       ImportSession[]       @relation("ImportSessionCreatedBy")

  @@map("users")
}

/// Better Auth session — authentication infrastructure, not a business
/// record. Deliberately NOT protected by a physical-deletion-rejection
/// trigger (docs/adr/0003-phase-2-authentication.md) — expiry pruning and
/// explicit revocation (sign-out, deactivation, password reset) are normal,
/// expected deletions here, unlike every table in Phase 1's migration.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Better Auth credential storage — `password` holds the Scrypt hash for
/// the `credential` provider. Authentication infrastructure, no
/// delete-rejection trigger (see Session's comment above).
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  issuer                String    @db.VarChar(255)
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(60)
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?   @db.VarChar(500)
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

/// Better Auth verification tokens — password-reset tokens (identifier
/// `reset-password:<token>`, stored hashed per `storeIdentifier: "hashed"`,
/// see docs/adr/0003-phase-2-authentication.md) and this project's own
/// invitation-gate tokens (identifier `invite-gate:<userId>`, written
/// directly by application code, never through Better Auth's adapter —
/// see src/lib/auth/invitation.ts). Authentication infrastructure, no
/// delete-rejection trigger.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
}

/// Referring labs and hospitals. Phase 7: `name`'s real uniqueness
/// guarantee is a functional index on `lower(btrim(name))` (added by hand
/// in the phase7_master_data_normalization migration — Prisma's DSL can't
/// express a functional index) — the plain `@unique` below only documents
/// intent for `prisma validate`/introspection, it is not the active
/// constraint after that migration runs. `updatedAt`/`updatedBy` back the
/// stale-write (compare-and-swap) protection every edit uses.
model Party {
  id            String      @id @default(uuid()) @db.Uuid
  name          String      @unique @db.VarChar(150)
  billingMode   BillingMode @map("billing_mode")
  isActive      Boolean     @default(true) @map("is_active")
  sortOrder     Int         @map("sort_order") @db.SmallInt
  updatedAt     DateTime?   @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?     @map("updated_by") @db.Uuid
  updatedByUser User?       @relation("PartyUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  partyIncome PartyIncome[]

  @@map("parties")
}

/// The dropdown list for daily expenses. See Party's comment re: the
/// functional lower(btrim(name)) uniqueness index and updatedAt/updatedBy.
model ExpenseItem {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique @db.VarChar(120)
  isActive      Boolean   @default(true) @map("is_active")
  updatedAt     DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  updatedByUser User?     @relation("ExpenseItemUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  dailyExpenses DailyExpense[]

  @@map("expense_items")
}

/// Monthly expense classification (administration and purchasing). See
/// Party's comment re: the functional lower(btrim(name)) uniqueness index
/// and updatedAt/updatedBy.
model ExpenseCategory {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @unique @db.VarChar(120)
  expenseGroup  ExpenseGroup @map("expense_group")
  isRecurring   Boolean      @default(false) @map("is_recurring")
  isActive      Boolean      @default(true) @map("is_active")
  updatedAt     DateTime?    @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?      @map("updated_by") @db.Uuid
  updatedByUser User?        @relation("ExpenseCategoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  monthlyExpenses  MonthlyExpense[]
  defaultForAssets Asset[]

  @@map("expense_categories")
}

/// Suppliers named in the purchasing list. See Party's comment re: the
/// functional lower(btrim(name)) uniqueness index and updatedAt/updatedBy.
model Vendor {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique @db.VarChar(150)
  isActive      Boolean   @default(true) @map("is_active")
  updatedAt     DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  updatedByUser User?     @relation("VendorUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  monthlyExpenses MonthlyExpense[]
  assets          Asset[]

  @@map("vendors")
}

/// One row per purchase. See migration.sql for the funding-source CHECKs
/// and the partner-eligibility trigger on funded_by_user_id.
model DailyExpense {
  id                String        @id @default(uuid()) @db.Uuid
  clientUuid        String        @unique @map("client_uuid") @db.Uuid
  expenseDate       DateTime      @map("expense_date") @db.Date
  expenseItemId     String?       @map("expense_item_id") @db.Uuid
  expenseItem       ExpenseItem?  @relation(fields: [expenseItemId], references: [id], onDelete: Restrict)
  customDescription String?       @map("custom_description") @db.VarChar(300)
  amount            Decimal       @db.Decimal(14, 2)
  fundingSource     FundingSource @map("funding_source")
  fundedByUserId    String?       @map("funded_by_user_id") @db.Uuid
  fundedBy          User?         @relation("DailyExpenseFundedBy", fields: [fundedByUserId], references: [id], onDelete: Restrict)
  isArchived        Boolean       @default(false) @map("is_archived")
  capturedAt        DateTime      @map("captured_at") @db.Timestamptz(6)
  syncedAt          DateTime?     @map("synced_at") @db.Timestamptz(6)
  createdBy         String        @map("created_by") @db.Uuid
  createdByUser     User          @relation("DailyExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy         String        @map("updated_by") @db.Uuid
  updatedByUser     User          @relation("DailyExpenseUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  updatedAt         DateTime      @map("updated_at") @db.Timestamptz(6)

  @@index([expenseDate])
  @@map("daily_expenses")
}

/// Administration and purchasing lines, including machine instalments
/// (asset_id set). See migration.sql for the instalment partial-unique
/// index and the funding-source CHECKs/trigger.
model MonthlyExpense {
  id             String          @id @default(uuid()) @db.Uuid
  clientUuid     String          @unique @map("client_uuid") @db.Uuid
  periodMonth    DateTime        @map("period_month") @db.Date
  categoryId     String          @map("category_id") @db.Uuid
  category       ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendorId       String?         @map("vendor_id") @db.Uuid
  vendor         Vendor?         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  assetId        String?         @map("asset_id") @db.Uuid
  asset          Asset?          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  description    String?         @db.VarChar(300)
  amount         Decimal         @db.Decimal(14, 2)
  fundingSource  FundingSource   @map("funding_source")
  fundedByUserId String?         @map("funded_by_user_id") @db.Uuid
  fundedBy       User?           @relation("MonthlyExpenseFundedBy", fields: [fundedByUserId], references: [id], onDelete: Restrict)
  isArchived     Boolean         @default(false) @map("is_archived")
  capturedAt     DateTime        @map("captured_at") @db.Timestamptz(6)
  syncedAt       DateTime?       @map("synced_at") @db.Timestamptz(6)
  createdBy      String          @map("created_by") @db.Uuid
  createdByUser  User            @relation("MonthlyExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy      String          @map("updated_by") @db.Uuid
  updatedByUser  User            @relation("MonthlyExpenseUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  updatedAt      DateTime        @map("updated_at") @db.Timestamptz(6)

  @@index([periodMonth])
  @@map("monthly_expenses")
}

/// Daily entries, monthly bills and direct cash receipts, in one table.
model PartyIncome {
  id            String      @id @default(uuid()) @db.Uuid
  clientUuid    String      @unique @map("client_uuid") @db.Uuid
  partyId       String      @map("party_id") @db.Uuid
  party         Party       @relation(fields: [partyId], references: [id], onDelete: Restrict)
  incomeDate    DateTime    @map("income_date") @db.Date
  amount        Decimal     @db.Decimal(14, 2)
  receiptType   ReceiptType @map("receipt_type")
  note          String?     @db.VarChar(300)
  isArchived    Boolean     @default(false) @map("is_archived")
  capturedAt    DateTime    @map("captured_at") @db.Timestamptz(6)
  syncedAt      DateTime?   @map("synced_at") @db.Timestamptz(6)
  createdBy     String      @map("created_by") @db.Uuid
  createdByUser User        @relation("PartyIncomeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String      @map("updated_by") @db.Uuid
  updatedByUser User        @relation("PartyIncomeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  updatedAt     DateTime    @map("updated_at") @db.Timestamptz(6)

  @@index([incomeDate])
  @@map("party_income")
}

/// Walk-in patient income, entered daily. No unique constraint on
/// income_date — see docs/adr/0002-phase-1-schema-clarifications.md
/// decision 5 (FR-CINC-04 requires a non-blocking warning, not rejection).
model CounterIncome {
  id            String    @id @default(uuid()) @db.Uuid
  clientUuid    String    @unique @map("client_uuid") @db.Uuid
  incomeDate    DateTime  @map("income_date") @db.Date
  amount        Decimal   @db.Decimal(14, 2)
  note          String?   @db.VarChar(300)
  isArchived    Boolean   @default(false) @map("is_archived")
  capturedAt    DateTime  @map("captured_at") @db.Timestamptz(6)
  syncedAt      DateTime? @map("synced_at") @db.Timestamptz(6)
  createdBy     String    @map("created_by") @db.Uuid
  createdByUser User      @relation("CounterIncomeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedByUser User      @relation("CounterIncomeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(6)

  @@index([incomeDate])
  @@map("counter_income")
}

/// Fixed and movable equipment. `status` is the sole archive
/// representation for this table — never `is_archived` (ADR-0002
/// decision 6). See migration.sql for the INSTALMENT/CASH mutual-
/// exclusivity CHECKs and the partner-eligibility trigger.
model Asset {
  id                String              @id @default(uuid()) @db.Uuid
  name              String              @db.VarChar(200)
  classification    AssetClassification
  acquisitionMode   AcquisitionMode     @map("acquisition_mode")
  monthlyInstalment Decimal?            @map("monthly_instalment") @db.Decimal(14, 2)
  purchasePrice     Decimal?            @map("purchase_price") @db.Decimal(14, 2)
  purchasedByUserId String?             @map("purchased_by_user_id") @db.Uuid
  purchasedBy       User?               @relation("AssetPurchasedBy", fields: [purchasedByUserId], references: [id], onDelete: Restrict)
  vendorId          String?             @map("vendor_id") @db.Uuid
  vendor            Vendor?             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  /// Phase 4: required only for INSTALMENT-mode assets (see the
  /// acquisition-mode CHECK in migration.sql) — the source of
  /// monthly_expenses.category_id for every system-generated instalment
  /// line (FR-AST-04), since that column is NOT NULL and no other part of
  /// an asset carries category information. Always NULL for CASH assets.
  defaultCategoryId String?             @map("default_category_id") @db.Uuid
  defaultCategory   ExpenseCategory?    @relation(fields: [defaultCategoryId], references: [id], onDelete: Restrict)
  acquiredOn        DateTime?           @map("acquired_on") @db.Date
  status            AssetStatus         @default(ACTIVE)
  createdBy         String              @map("created_by") @db.Uuid
  createdByUser     User                @relation("AssetCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy         String              @map("updated_by") @db.Uuid
  updatedByUser     User                @relation("AssetUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  updatedAt         DateTime            @map("updated_at") @db.Timestamptz(6)

  monthlyExpenseLines MonthlyExpense[]

  @@map("assets")
}

/// Direct injections and withdrawals of partner money. partner_user_id is
/// always required (never conditional) — see the partner-eligibility
/// trigger in migration.sql.
model CapitalContribution {
  id               String           @id @default(uuid()) @db.Uuid
  partnerUserId    String           @map("partner_user_id") @db.Uuid
  partner          User             @relation("CapitalContributionPartner", fields: [partnerUserId], references: [id], onDelete: Restrict)
  entryDate        DateTime         @map("entry_date") @db.Date
  amount           Decimal          @db.Decimal(14, 2)
  contributionType ContributionType @map("contribution_type")
  note             String?          @db.VarChar(500)
  isArchived       Boolean          @default(false) @map("is_archived")
  createdBy        String           @map("created_by") @db.Uuid
  createdByUser    User             @relation("CapitalContributionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy        String           @map("updated_by") @db.Uuid
  updatedByUser    User             @relation("CapitalContributionUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  updatedAt        DateTime         @map("updated_at") @db.Timestamptz(6)

  @@map("capital_contributions")
}

/// Append-only. actor_user_id is nullable to represent a failed sign-in
/// against an email that matches no user (entity_id = 'unknown' in that
/// case) — see docs/adr/0002-phase-1-schema-clarifications.md and the
/// append-only trigger in migration.sql, which rejects every UPDATE/DELETE.
model AuditLog {
  id          BigInt      @id @default(autoincrement())
  actorUserId String?     @map("actor_user_id") @db.Uuid
  actor       User?       @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action      AuditAction
  entityType  String      @map("entity_type") @db.VarChar(60)
  entityId    String      @map("entity_id") @db.VarChar(60)
  oldValues   Json?       @map("old_values") @db.JsonB
  newValues   Json?       @map("new_values") @db.JsonB
  capturedAt  DateTime    @map("captured_at") @db.Timestamptz(6)
  syncedAt    DateTime?   @map("synced_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@map("audit_log")
}

/// Configuration held as data. updated_by is nullable — see
/// docs/adr/0002-phase-1-schema-clarifications.md decision 4 (the seeded
/// default profit split exists before any user account does).
///
/// Phase 5: partner_a_user_id/partner_b_user_id are populated only on the
/// settingKey = 'profit_split' row — see docs/adr/0007-phase-5-
/// calculations-dashboard-reports.md. Explicit identity mapping, never inferred
/// from account creation order; both-or-neither and distinct-partner rules
/// are enforced by CHECK constraints, partner eligibility by the same
/// reject_if_not_partner trigger every other partner-tag column uses (see
/// migration.sql).
/// Phase 7: `splitAPercent`/`splitBPercent` are the authoritative,
/// Decimal-typed profit-split percentages (only ever populated on the
/// settingKey = 'profit_split' row) — `settingValue`'s old
/// `{partner_a, partner_b}` JSON keys are no longer read or written by
/// application code once the phase7_profit_split_columns migration runs
/// (disclosed deviation, see docs/adr/0009-phase-7-administration-and-
/// import.md); the JSONB column itself is left in place for schema
/// stability, not repurposed. A database CHECK (added by hand, same
/// migration) enforces both columns NOT NULL, each in [0,100], and their
/// sum exactly 100 — for the profit_split row only.
model AppSetting {
  settingKey     String   @id @map("setting_key") @db.VarChar(80)
  settingValue   Json     @map("setting_value") @db.JsonB
  splitAPercent  Decimal? @map("split_a_percent") @db.Decimal(5, 2)
  splitBPercent  Decimal? @map("split_b_percent") @db.Decimal(5, 2)
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedByUser  User?    @relation("AppSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(6)
  partnerAUserId String?  @map("partner_a_user_id") @db.Uuid
  partnerBUserId String?  @map("partner_b_user_id") @db.Uuid
  partnerA       User?    @relation("AppSettingPartnerA", fields: [partnerAUserId], references: [id], onDelete: Restrict)
  partnerB       User?    @relation("AppSettingPartnerB", fields: [partnerBUserId], references: [id], onDelete: Restrict)

  @@map("app_settings")
}

/// Phase 6 (offline sync, FR-OFF-01–14, DR-05, NFR-REL-05). One durable
/// receipt per queued offline operation the sync-upload endpoint has ever
/// accepted, applied, rejected, or found in conflict — this is what makes
/// re-uploading a batch after a dropped connection safe: a retried
/// `operationId` is looked up here FIRST; a match with an identical
/// `requestFingerprint` replays `resultBody` verbatim without re-running the
/// business mutation or writing a second audit row (see
/// src/server/sync/apply.ts and docs/adr/0008-phase-6-offline-sync.md). A
/// match with a *different* fingerprint is rejected as `OPERATION_ID_REUSED`
/// — an operation id must never be reused for a different logical request.
///
/// `operationId` is the client-generated queue-operation id (never
/// `clientUuid`, which identifies the underlying business record, not the
/// operation) — see src/lib/offline/queue.ts. `requestFingerprint` is a
/// SHA-256 hex digest (64 hex chars) of the canonical JSON operation body
/// (CLAUDE.md Phase 6 mandatory decision #1). `resultBody` is the verbatim
/// JSON response payload replayed on a retry.
///
/// Deliberately NOT covered by the physical-deletion-rejection triggers in
/// migration.sql — like `sessions`/`account`/`verification` (Phase 2), this
/// is infrastructure, not a business/financial record. Rows here are safe to
/// delete only under the documented retention policy (see ADR-0008 §Receipt
/// Retention and src/server/sync/retention.ts) — never a blind TTL, since a
/// slow or still-offline client may legitimately retry against an old
/// operationId for as long as its own queue entry survives.
model SyncOperation {
  operationId        String              @id @map("operation_id") @db.Uuid
  actorUserId        String              @map("actor_user_id") @db.Uuid
  actor              User                @relation("SyncOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  entityType         String              @map("entity_type") @db.VarChar(60)
  clientUuid         String              @map("client_uuid") @db.Uuid
  action             SyncOperationAction
  requestFingerprint String              @map("request_fingerprint") @db.VarChar(64)
  status             SyncOperationStatus
  resultBody         Json                @map("result_body") @db.JsonB
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorUserId])
  @@index([entityType, clientUuid])
  @@index([createdAt])
  @@map("sync_operations")
}

enum SyncOperationAction {
  CREATE
  UPDATE
  ARCHIVE

  @@map("sync_operation_action")
}

enum SyncOperationStatus {
  RECEIVED
  APPLIED
  CONFLICT
  REJECTED

  @@map("sync_operation_status")
}

/// Phase 7 (FR-IMP-01 to 04). The durable, byte-free import history — one
/// row per attempted historical-data import, kept forever for audit
/// traceability and as the idempotency-check source (`fileHash`, never
/// `audit_log` JSON — see docs/adr/0009-phase-7-administration-and-
/// import.md). Never stores workbook bytes (that is `ImportSession`'s job,
/// and only for the ~15-minute preview/commit window). Physically
/// delete-protected like every other business/audit record (CLAUDE.md
/// §11) — nothing in this system ever deletes an import's history.
model ImportBatch {
  id            String            @id @default(uuid()) @db.Uuid
  fileHash      String            @map("file_hash") @db.VarChar(64)
  fileName      String            @map("file_name") @db.VarChar(255)
  actorUserId   String            @map("actor_user_id") @db.Uuid
  actor         User              @relation("ImportBatchActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  status        ImportBatchStatus @default(PENDING)
  totalRows     Int               @default(0) @map("total_rows")
  importedRows  Int               @default(0) @map("imported_rows")
  resultSummary Json?             @map("result_summary") @db.JsonB
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt   DateTime?         @map("completed_at") @db.Timestamptz(6)

  sessions ImportSession[]

  @@index([fileHash])
  @@map("import_batches")
}

enum ImportBatchStatus {
  PENDING
  COMMITTED
  FAILED

  @@map("import_batch_status")
}

/// Phase 7. The ephemeral, single-use claim ticket for one preview→commit
/// round trip — `fileBytes` exists only here, only for
/// `expiresAt` (~15 minutes), and is always gone (row deleted, or bytes
/// nulled by cleanup) well before this table could ever be mistaken for
/// durable storage; `ImportBatch` is the durable record. `status` is
/// claimed atomically (`UPDATE ... WHERE status = 'PENDING' ... RETURNING`)
/// by the commit endpoint before any parsing/business-row work begins, so
/// a concurrent or retried commit against the same session can never
/// proceed twice — see src/server/import/commit.ts. Deliberately NOT
/// covered by the physical-deletion-rejection trigger (like
/// sessions/account/verification/sync_operations) — this is transient
/// upload infrastructure, not a business/financial record; deleting a
/// completed or expired row's bytes is the whole point.
model ImportSession {
  id            String              @id @default(uuid()) @db.Uuid
  batchId       String              @map("batch_id") @db.Uuid
  batch         ImportBatch         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  fileHash      String              @map("file_hash") @db.VarChar(64)
  fileBytes     Bytes?              @map("file_bytes")
  status        ImportSessionStatus @default(PENDING)
  createdBy     String              @map("created_by") @db.Uuid
  createdByUser User                @relation("ImportSessionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime            @map("expires_at") @db.Timestamptz(6)
  claimedAt     DateTime?           @map("claimed_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("import_sessions")
}

enum ImportSessionStatus {
  PENDING
  CLAIMED
  COMMITTED
  FAILED
  EXPIRED

  @@map("import_session_status")
}
